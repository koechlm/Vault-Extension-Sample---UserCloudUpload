    <Content Include="Resources\CheckOut_32_dark.png" />
    <Content Include="Resources\cmdPush_16_dark.png" />
    <Content Include="Resources\cmdPush_16_light.ico" />
    <Content Include="Resources\cmdPush_32_dark.png" />
    <Content Include="Resources\GlobalFolderView_16_dark.png" />
    <Content Include="Resources\GlobalFolderView_16_light.ico" />
    <Content Include="Resources\GlobalFolderView_32_dark.png" />
    <Content Include="Resources\Sites_16_dark.png" />
    <Content Include="Resources\Sites_16_light.ico" />
    <Content Include="Resources\Sites_32_dark.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\licenses.licx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1370.28" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.DirectoryServices" Version="9.0.1" />
  </ItemGroup>
</Project>